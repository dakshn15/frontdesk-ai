# Locally, `npm run env:local` writes .env.local from the running Supabase stack.

# Postgres connection used by Drizzle. In production, use Supabase's transaction pooler (port 6543).
DATABASE_URL=
# Connections per server instance (optional, default 5).
DB_POOL_MAX=
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (safe for the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app, with no trailing slash.
NEXT_PUBLIC_SITE_URL=
# "true" shows "Continue with Google" once the Google provider is set up in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

# Test only: Supabase secret key, used by test helpers to create users.
SUPABASE_SECRET_KEY=
# Test only: the local Mailpit server that catches auth emails.
MAILPIT_URL=

# Optional: Resend API key. Without it, emails are logged in email_log and not sent.
RESEND_API_KEY=
# Optional: sender, e.g. "Bloom Hair & Beauty <bookings@yourdomain.com>". Resend's test
# sender (the default) only delivers to the Resend account's own address.
EMAIL_FROM=
# Required to let workspaces save their own OpenAI or Gemini keys (Settings → AI keys): any
# random string of 32+ characters. It encrypts the saved keys, so never change it afterwards.
AI_KEYS_SECRET=
# Optional: the platform's own OpenAI key, used only by live demo copies. Workspaces answer
# with the keys they save in Settings. Set a monthly spend limit in OpenAI's dashboard.
OPENAI_API_KEY=
# Optional: any random string of 16+ characters. Vercel Cron sends it to the daily
# reminder job; without it, reminder emails don't go out.
CRON_SECRET=
# Optional: the platform's own Google AI Studio key for Gemini, used only by live demo copies.
GOOGLE_GENERATIVE_AI_API_KEY=
# Test only: "1" uses a scripted model instead of a real one (ignored on Vercel).
AI_FAKE=
